{
  "name": "blog",
  "version": "7.0.0",
  "description": "Blog module",
  "dnn": {
    "projectFolders": [
      "Server/Blog"
    ],
    "owner": {
      "name": "Peter Donker",
      "organization": "Dnn",
      "url": "dnn.com",
      "email": "peter@bring2mind.net"
    },
    "pathsAndFiles": {
      "solutionFile": "./Dnn.Blog.sln",
      "pathToAssemblies": "./bin",
      "devSiteUrl": "",
      "devSitePath": "",
      "excludeFilter": [
        "bin/",
        "obj/",
        "node_modules"
      ],
      "licenseFile": "./License.md",
      "releaseNotesFile": "",
      "releaseFiles": [
        "App_LocalResources/*.resx",
        "**/*.ascx",
        "**/*.ashx",
        "**/*.cshtml",
        "**/*.vbhtml",
        "js/*.js",
        "css/*.css",
        "*.css",
        "**/*.html",
        "**/*.png",
        "**/*.jpg",
        "**/*.jpeg",
        "**/*.gif",
        "**/*.eot",
        "**/*.svg",
        "**/*.ttf",
        "**/*.woff",
        "**/*.woff2",
        "*.txt"
      ],
      "zipName": "Dnn.Blog"
    }
  },
  "scripts": {
    "build": "rsbuild build --config Client/rsbuild.config.ts",
    "watch": "rsbuild build --config Client/rsbuild.config.ts --watch",
    "watch-server": "node watch.js"
  },
  "author": "Peter Donker",
  "devDependencies": {
    "@rsbuild/core": "^1.5.3",
    "@rsbuild/plugin-react": "^1.4.0",
    "@rsbuild/plugin-sass": "^1.4.0",
    "@types/dompurify": "^3.0.5",
    "@types/flatpickr": "^3.0.2",
    "@types/jquery": "^4.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "chokidar": "^6.0.0",
    "deepmerge": "^4.3.1",
    "fs-extra": "^11.4.1",
    "jquery": "^4.0.0",
    "postcss": "^8.5.31",
    "sass": "^1.106.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "dompurify": "^3.4.17",
    "flatpickr": "^4.6.13",
    "markdown-it": "^15.0.3",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "^1.42.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
