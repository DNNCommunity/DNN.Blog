{
  "name": "blog",
  "version": "7.0.0",
  "description": "Blog module",
  "dnn": {
    "projectFolders": [
      "Server/Blog"
    ],
    "owner": {
      "name": "Peter Donker",
      "organization": "Dnn",
      "url": "dnn.com",
      "email": "peter@bring2mind.net"
    },
    "pathsAndFiles": {
      "solutionFile": "./Dnn.Blog.sln",
      "pathToAssemblies": "./bin",
      "devSiteUrl": "",
      "devSitePath": "",
      "excludeFilter": [
        "bin/",
        "obj/",
        "node_modules"
      ],
      "licenseFile": "./License.md",
      "releaseNotesFile": "",
      "releaseFiles": [
        "App_LocalResources/*.resx",
        "**/*.ascx",
        "**/*.cshtml",
        "**/*.vbhtml",
        "js/*.js",
        "css/*.css",
        "*.css",
        "**/*.html",
        "**/*.png",
        "**/*.jpg",
        "**/*.jpeg",
        "**/*.gif",
        "**/*.eot",
        "**/*.svg",
        "**/*.ttf",
        "**/*.woff",
        "**/*.woff2",
        "*.txt"
      ],
      "zipName": "Dnn.Blog"
    }
  },
  "scripts": {
    "build": "rsbuild build --config Client/rsbuild.config.ts",
    "watch": "rsbuild build --config Client/rsbuild.config.ts --watch",
    "watch-server": "node watch.js"
  },
  "author": "Peter Donker",
  "devDependencies": {
    "@rsbuild/core": "^1.5.3",
    "@rsbuild/plugin-react": "^1.4.0",
    "@rsbuild/plugin-sass": "^1.4.0",
    "@types/jquery": "^4.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chokidar": "^6.0.0",
    "deepmerge": "^4.3.1",
    "fs-extra": "^11.4.1",
    "jquery": "^4.0.0",
    "sass": "^1.106.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
