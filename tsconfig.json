{
  "compilerOptions": {
    "target": "es2016",
    "lib": ["es2016", "dom"],
    "module": "es2015",
    "moduleResolution": "bundler",
    "jsx": "react",
    "noImplicitAny": false,
    "sourceMap": true,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "allowJs": true,
    "rootDir": "Client/Js",
    "outDir": "./dist"
  },
  "include": ["Client/Js/**/*.ts", "Client/Js/**/*.tsx", "Client/Js/**/*.jsx"],
  "exclude": ["node_modules", "dist"]
}
