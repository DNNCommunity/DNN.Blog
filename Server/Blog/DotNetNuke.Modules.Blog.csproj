<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>DotNetNuke.Modules.Blog</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <OutputPath>..\..\bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Authors>Peter Donker</Authors>
    <Company>Dnn</Company>
    <Product>blog</Product>
    <Copyright>Copyright 2026 by Dnn</Copyright>
    <PackageId>DotNetNuke.Modules.Blog</PackageId>
    <AssemblyVersion>7.0.0</AssemblyVersion>
    <FileVersion>7.0.0</FileVersion>
    <Description>Blog module</Description>
    <NeutralLanguage>en-US</NeutralLanguage>
    <ApplicationIcon />
    <OutputType>Library</OutputType>
    <StartupObject />
    <DebugType>Portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DotNetNuke.Core" Version="10.4.0" />
    <PackageReference Include="DotNetNuke.DependencyInjection" Version="10.4.0" />
    <PackageReference Include="DotNetNuke.Instrumentation" Version="10.4.0" />
    <PackageReference Include="DotNetNuke.Web" Version="10.4.0" />
    <PackageReference Include="DotNetNuke.Web.Client" Version="10.4.0" />
    <PackageReference Include="DotNetNuke.Web.Mvc" Version="10.4.0" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
  </ItemGroup>
</Project>