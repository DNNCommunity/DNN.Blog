@inherits BlogWebPage<DotNetNuke.Modules.Blog.Models.AdminViewModel>
@using DotNetNuke.Modules.Blog.Common
@using DotNetNuke.Modules.Blog.Core.Common
@using System.Linq
@{
  var summary0 = Model.Settings.SummaryModel == SummaryType.PlainTextIndependent ? "selected" : "";
  var summary1 = Model.Settings.SummaryModel == SummaryType.HtmlIndependent ? "selected" : "";
  var summary2 = Model.Settings.SummaryModel == SummaryType.HtmlPrecedesPost ? "selected" : "";
  var updateLabel = Dnn.LocalizeString("cmdUpdate");
  if (string.IsNullOrWhiteSpace(updateLabel)) { updateLabel = "Update"; }
  var cancelLabel = Dnn.LocalizeString("Cancel");
  if (string.IsNullOrWhiteSpace(cancelLabel)) { cancelLabel = "Cancel"; }
  var security = BlogModuleContext.Security;
  var securityJson = Newtonsoft.Json.JsonConvert.SerializeObject(new
  {
    UserId = Dnn.User.UserID,
    CanView = true,
    CanEdit = security.IsEditor,
    IsAdmin = security.UserIsAdmin
  });
  var localesJson = Newtonsoft.Json.JsonConvert.SerializeObject(
    Model.Locales.Select(l => new { Code = l.Code, Name = l.EnglishName }));
}
<div class="blog-admin">
  <header class="blog-admin__header">
    <h1 class="blog-admin__title">Blog settings</h1>
    <p class="blog-admin__subtitle">Module configuration</p>
  </header>

  <div class="blog-admin__tabs" data-blog-admin-tabs>
    <div class="blog-admin__tablist" role="tablist">
      <button type="button" class="blog-admin__tab is-active" role="tab" aria-selected="true" data-tab="settings">Settings</button>
      <button type="button" class="blog-admin__tab" role="tab" aria-selected="false" data-tab="categories">Categories</button>
      <button type="button" class="blog-admin__tab" role="tab" aria-selected="false" data-tab="tags">Tags</button>
    </div>

    <div class="blog-admin__tabpanel is-active" role="tabpanel" data-tabpanel="settings">
      <form action="@Url.Action("Index", "Admin")" method="post">
        @MvcHtml.AntiForgeryToken()

        <section class="blog-admin__section">
          <h2 class="blog-admin__section-title">@Dnn.LocalizeString("General")</h2>
          <div class="blog-admin__fields">
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="SummaryModel">Summary model</label>
              <div class="blog-admin__control">
                <select id="SummaryModel" name="SummaryModel" class="blog-admin__input">
                  <option value="0" @summary0>Plain text</option>
                  <option value="1" @summary1>HTML independent</option>
                  <option value="2" @summary2>HTML precedes post</option>
                </select>
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="AutoGenerateMissingSummary">Auto-generate summary</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="AutoGenerateMissingSummary" name="AutoGenerateMissingSummary" value="true" @(Model.Settings.AutoGenerateMissingSummary ? "checked=\"checked\"" : null) />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="AutoGeneratedSummaryLength">Summary length</label>
              <div class="blog-admin__control">
                <input type="text" id="AutoGeneratedSummaryLength" name="AutoGeneratedSummaryLength" value="@Model.Settings.AutoGeneratedSummaryLength" class="blog-admin__input blog-admin__input--narrow" />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="VocabularyId">Vocabulary</label>
              <div class="blog-admin__control">
                @Html.DropDownList("VocabularyId", Model.Vocabularies, new { @class = "blog-admin__input", id = "VocabularyId" })
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="AllowMultipleCategories">Allow multiple categories</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="AllowMultipleCategories" name="AllowMultipleCategories" value="true" @(Model.Settings.AllowMultipleCategories ? "checked=\"checked\"" : null) />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="AllowAttachments">Allow attachments</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="AllowAttachments" name="AllowAttachments" value="true" @(Model.Settings.AllowAttachments ? "checked=\"checked\"" : null) />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="AllowWLW">Allow WLW</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="AllowWLW" name="AllowWLW" value="true" @(Model.Settings.AllowWLW ? "checked=\"checked\"" : null) />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="WLWRecentPostsMax">WLW recent posts max</label>
              <div class="blog-admin__control">
                <input type="text" id="WLWRecentPostsMax" name="WLWRecentPostsMax" value="@Model.Settings.WLWRecentPostsMax" class="blog-admin__input blog-admin__input--narrow" />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="ModifyPageDetails">Modify page details</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="ModifyPageDetails" name="ModifyPageDetails" value="true" @(Model.Settings.ModifyPageDetails ? "checked=\"checked\"" : null) />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="IncrementViewCount">View count delay (sec)</label>
              <div class="blog-admin__control">
                <input type="text" id="IncrementViewCount" name="IncrementViewCount" value="@Model.Settings.IncrementViewCount" class="blog-admin__input blog-admin__input--narrow" />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="FacebookAppId">Facebook App Id</label>
              <div class="blog-admin__control">
                <input type="text" id="FacebookAppId" name="FacebookAppId" value="@Model.Settings.FacebookAppId" class="blog-admin__input" />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="FacebookProfileIdProperty">Facebook profile property</label>
              <div class="blog-admin__control">
                @Html.DropDownList("FacebookProfileIdProperty", Model.FacebookProfileProperties, new { @class = "blog-admin__input", id = "FacebookProfileIdProperty" })
              </div>
            </div>
          </div>
        </section>

        <section class="blog-admin__section">
          <h2 class="blog-admin__section-title">RSS</h2>
          <div class="blog-admin__fields">
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssDefaultNrItems">Default items</label>
              <div class="blog-admin__control">
                <input type="text" id="RssDefaultNrItems" name="RssDefaultNrItems" value="@Model.Settings.RssDefaultNrItems" class="blog-admin__input blog-admin__input--narrow" />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssMaxNrItems">Max items</label>
              <div class="blog-admin__control">
                <input type="text" id="RssMaxNrItems" name="RssMaxNrItems" value="@Model.Settings.RssMaxNrItems" class="blog-admin__input blog-admin__input--narrow" />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssTtl">TTL</label>
              <div class="blog-admin__control">
                <input type="text" id="RssTtl" name="RssTtl" value="@Model.Settings.RssTtl" class="blog-admin__input blog-admin__input--narrow" />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssEmail">Email</label>
              <div class="blog-admin__control">
                <input type="text" id="RssEmail" name="RssEmail" value="@Model.Settings.RssEmail" class="blog-admin__input" />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssDefaultCopyright">Default copyright</label>
              <div class="blog-admin__control">
                <input type="text" id="RssDefaultCopyright" name="RssDefaultCopyright" value="@Model.Settings.RssDefaultCopyright" class="blog-admin__input blog-admin__input--wide" />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssAllowContentInFeed">Allow content in feed</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="RssAllowContentInFeed" name="RssAllowContentInFeed" value="true" @(Model.Settings.RssAllowContentInFeed ? "checked=\"checked\"" : null) />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssImageWidth">Image width</label>
              <div class="blog-admin__control">
                <input type="text" id="RssImageWidth" name="RssImageWidth" value="@Model.Settings.RssImageWidth" class="blog-admin__input blog-admin__input--narrow" />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssImageHeight">Image height</label>
              <div class="blog-admin__control">
                <input type="text" id="RssImageHeight" name="RssImageHeight" value="@Model.Settings.RssImageHeight" class="blog-admin__input blog-admin__input--narrow" />
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssImageSizeAllowOverride">Image size override</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="RssImageSizeAllowOverride" name="RssImageSizeAllowOverride" value="true" @(Model.Settings.RssImageSizeAllowOverride ? "checked=\"checked\"" : null) />
              </div>
            </div>
          </div>
        </section>

        <div class="blog-admin__actions">
          <button type="submit" class="blog-admin__btn blog-admin__btn--primary">@updateLabel</button>
          <a href="@DotNetNuke.Common.Globals.NavigateURL()" class="blog-admin__btn blog-admin__btn--secondary">@cancelLabel</a>
        </div>
      </form>
    </div>

    <div class="blog-admin__tabpanel" role="tabpanel" data-tabpanel="categories" hidden>
      @if (!Model.HasVocabulary)
      {
        <div class="blog-admin__callout blog-admin__callout--warning">
          <div class="blog-admin__callout-body">
            <p class="blog-admin__callout-title">No category vocabulary configured</p>
            <p class="blog-admin__callout-text">Categories need a vocabulary before they can be managed. Create one to continue, or select a vocabulary on the Settings tab.</p>
          </div>
          <button type="submit" form="blog-admin-create-vocab" class="blog-admin__btn blog-admin__btn--callout">Create vocabulary</button>
        </div>
      }
      else
      {
        <div class="Blog"
             data-moduleid="@Dnn.ActiveModule.ModuleID"
             data-component="categories-editor"
             data-vocabulary-id="@Model.Settings.VocabularyId"
             data-default-locale="@Model.DefaultLocale"
             data-locales="@localesJson"
             data-multilingual="@(Model.ShowMultilingualLinks ? "true" : "false")">
        </div>
      }
    </div>

    <div class="blog-admin__tabpanel" role="tabpanel" data-tabpanel="tags" hidden>
      <div class="Blog"
           data-moduleid="@Dnn.ActiveModule.ModuleID"
           data-component="tags-editor"
           data-default-locale="@Model.DefaultLocale"
           data-locales="@localesJson">
      </div>
    </div>
  </div>

  <div class="DotNetNukeBlog"
       data-moduleid="@Dnn.ActiveModule.ModuleID"
       data-tabid="@Dnn.ActiveModule.TabID"
       data-locale="@Locale"
       data-resources="@SerializedResources()"
       data-security="@securityJson">
  </div>

  @if (!Model.HasVocabulary)
  {
    <form id="blog-admin-create-vocab" action="@Url.Action("CreateVocabulary", "Admin")" method="post" hidden>
      @MvcHtml.AntiForgeryToken()
    </form>
  }
</div>
<script type="text/javascript">
  (function () {
    var root = document.querySelector('[data-blog-admin-tabs]');
    if (!root) return;
    var tabs = root.querySelectorAll('.blog-admin__tab');
    var panels = root.querySelectorAll('.blog-admin__tabpanel');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var id = tab.getAttribute('data-tab');
        tabs.forEach(function (t) {
          var on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach(function (p) {
          var on = p.getAttribute('data-tabpanel') === id;
          p.classList.toggle('is-active', on);
          if (on) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', 'hidden'); }
        });
      });
    });
  })();
</script>
