@inherits BlogWebPage<DotNetNuke.Modules.Blog.Models.AdminViewModel>
@using DotNetNuke.Modules.Blog.Common
@using DotNetNuke.Modules.Blog.Core.Common
@using System
@using System.Linq
@{
  Func<string, string, string> L = (key, fallback) =>
  {
    var s = Dnn.LocalizeString(key);
    if (string.IsNullOrWhiteSpace(s)) s = Dnn.LocalizeString(key + ".Text");
    return string.IsNullOrWhiteSpace(s) ? fallback : s;
  };
  Func<string, string> H = key =>
  {
    var helpKey = key.EndsWith(".Help", StringComparison.OrdinalIgnoreCase) ? key : key + ".Help";
    var s = Dnn.LocalizeString(helpKey);
    return string.IsNullOrWhiteSpace(s) ? "" : s;
  };
  var summary0 = Model.Settings.SummaryModel == SummaryType.PlainTextIndependent ? "selected" : "";
  var summary1 = Model.Settings.SummaryModel == SummaryType.HtmlIndependent ? "selected" : "";
  var summary2 = Model.Settings.SummaryModel == SummaryType.HtmlPrecedesPost ? "selected" : "";
  var editorHtml = string.Equals(Model.Settings.EditorMode, "markdown", StringComparison.OrdinalIgnoreCase) ? "" : "selected";
  var editorMarkdown = string.Equals(Model.Settings.EditorMode, "markdown", StringComparison.OrdinalIgnoreCase) ? "selected" : "";
  var updateLabel = L("cmdUpdate", "Update");
  var cancelLabel = L("Cancel", "Cancel");
  var security = BlogModuleContext.Security;
  var securityJson = Newtonsoft.Json.JsonConvert.SerializeObject(new
  {
    UserId = Dnn.User.UserID,
    CanView = true,
    CanEdit = security.IsEditor,
    IsAdmin = security.UserIsAdmin
  });
  var localesJson = Newtonsoft.Json.JsonConvert.SerializeObject(
    Model.Locales.Select(l => new { Code = l.Code, Name = l.EnglishName }));
}
<div class="blog-admin">
  <header class="blog-admin__header">
    <h1 class="blog-admin__title">Blog settings</h1>
    <p class="blog-admin__subtitle">Module configuration</p>
  </header>

  <div class="blog-admin__tabs" data-blog-admin-tabs>
    <div class="blog-admin__tablist" role="tablist">
      <button type="button" class="blog-admin__tab is-active" role="tab" aria-selected="true" data-tab="settings">Settings</button>
      <button type="button" class="blog-admin__tab" role="tab" aria-selected="false" data-tab="categories">Categories</button>
      <button type="button" class="blog-admin__tab" role="tab" aria-selected="false" data-tab="tags">Tags</button>
    </div>

    <div class="blog-admin__tabpanel is-active" role="tabpanel" data-tabpanel="settings">
      <form action="@Url.Action("Index", "Admin")" method="post">
        @MvcHtml.AntiForgeryToken()

        <section class="blog-admin__section">
          <h2 class="blog-admin__section-title">@L("General", "General")</h2>
          <div class="blog-admin__fields">
            @{
              var hSummaryModel = H("lblSummaryModel");
              var hEditorMode = H("lblEditorMode");
              var hAutoSummary = H("lblAutoGenerateMissingSummary");
              var hSummaryLen = H("lblAutoGeneratedSummaryLength");
              var hVocab = H("lblVocabularyId");
              var hMultiCat = H("lblAllowMultipleCategories");
              var hAttach = H("lblAllowAttachments");
              var hWlw = H("lblAllowWLW");
              var hWlwMax = H("lblWLWRecentPostsMax");
              var hPageDetails = H("lblModifyPageDetails");
              var hViewCount = H("lblIncrementViewCount");
              var olwHtmlOnlyNote = L("OLWHtmlOnly.Help", "Open Live Writer connections are only available for blogs configured to use HTML (not Markdown).");
            }
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="SummaryModel">@L("lblSummaryModel", "Summary model")</label>
              <div class="blog-admin__control">
                <select id="SummaryModel" name="SummaryModel" class="blog-admin__input" aria-describedby="@(string.IsNullOrEmpty(hSummaryModel) ? null : "hint-SummaryModel")">
                  <option value="0" @summary0>@L("PlainTextIndependent.Opt", "Plain text")</option>
                  <option value="1" @summary1>@L("HtmlIndependent.Opt", "HTML independent")</option>
                  <option value="2" @summary2>@L("HtmlPrecedesPost.Opt", "HTML precedes post")</option>
                </select>
                @if (!string.IsNullOrEmpty(hSummaryModel)) { <p class="blog-admin__field-hint" id="hint-SummaryModel">@hSummaryModel</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="EditorMode">@L("lblEditorMode", "Editor mode")</label>
              <div class="blog-admin__control">
                <select id="EditorMode" name="EditorMode" class="blog-admin__input" aria-describedby="@(string.IsNullOrEmpty(hEditorMode) ? null : "hint-EditorMode")">
                  <option value="html" @editorHtml>HTML</option>
                  <option value="markdown" @editorMarkdown>Markdown</option>
                </select>
                @if (!string.IsNullOrEmpty(hEditorMode)) { <p class="blog-admin__field-hint" id="hint-EditorMode">@hEditorMode</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="AutoGenerateMissingSummary">@L("lblAutoGenerateMissingSummary", "Auto-generate summary")</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="AutoGenerateMissingSummary" name="AutoGenerateMissingSummary" value="true" @(Model.Settings.AutoGenerateMissingSummary ? "checked=\"checked\"" : null) aria-describedby="@(string.IsNullOrEmpty(hAutoSummary) ? null : "hint-AutoGenerateMissingSummary")" />
                @if (!string.IsNullOrEmpty(hAutoSummary)) { <p class="blog-admin__field-hint" id="hint-AutoGenerateMissingSummary">@hAutoSummary</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="AutoGeneratedSummaryLength">@L("lblAutoGeneratedSummaryLength", "Summary length")</label>
              <div class="blog-admin__control">
                <input type="text" id="AutoGeneratedSummaryLength" name="AutoGeneratedSummaryLength" value="@Model.Settings.AutoGeneratedSummaryLength" class="blog-admin__input blog-admin__input--narrow" aria-describedby="@(string.IsNullOrEmpty(hSummaryLen) ? null : "hint-AutoGeneratedSummaryLength")" />
                @if (!string.IsNullOrEmpty(hSummaryLen)) { <p class="blog-admin__field-hint" id="hint-AutoGeneratedSummaryLength">@hSummaryLen</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="VocabularyId">@L("lblVocabularyId", "Vocabulary")</label>
              <div class="blog-admin__control">
                @Html.DropDownList("VocabularyId", Model.Vocabularies, new { @class = "blog-admin__input", id = "VocabularyId", aria_describedby = string.IsNullOrEmpty(hVocab) ? null : "hint-VocabularyId" })
                @if (!string.IsNullOrEmpty(hVocab)) { <p class="blog-admin__field-hint" id="hint-VocabularyId">@hVocab</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="AllowMultipleCategories">@L("lblAllowMultipleCategories", "Allow multiple categories")</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="AllowMultipleCategories" name="AllowMultipleCategories" value="true" @(Model.Settings.AllowMultipleCategories ? "checked=\"checked\"" : null) aria-describedby="@(string.IsNullOrEmpty(hMultiCat) ? null : "hint-AllowMultipleCategories")" />
                @if (!string.IsNullOrEmpty(hMultiCat)) { <p class="blog-admin__field-hint" id="hint-AllowMultipleCategories">@hMultiCat</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="AllowAttachments">@L("lblAllowAttachments", "Allow attachments")</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="AllowAttachments" name="AllowAttachments" value="true" @(Model.Settings.AllowAttachments ? "checked=\"checked\"" : null) aria-describedby="@(string.IsNullOrEmpty(hAttach) ? null : "hint-AllowAttachments")" />
                @if (!string.IsNullOrEmpty(hAttach)) { <p class="blog-admin__field-hint" id="hint-AllowAttachments">@hAttach</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="AllowWLW">@L("lblAllowWLW", "Allow Open Live Writer")</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="AllowWLW" name="AllowWLW" value="true" @(Model.Settings.AllowWLW ? "checked=\"checked\"" : null) aria-describedby="@(string.IsNullOrEmpty(hWlw) ? null : "hint-AllowWLW") hint-OLWHtmlOnly" />
                @if (!string.IsNullOrEmpty(hWlw)) { <p class="blog-admin__field-hint" id="hint-AllowWLW">@hWlw</p> }
                <p class="blog-admin__field-hint" id="hint-OLWHtmlOnly">@olwHtmlOnlyNote</p>
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="WLWRecentPostsMax">@L("lblWLWRecentPostsMax", "OLW max recent posts")</label>
              <div class="blog-admin__control">
                <input type="text" id="WLWRecentPostsMax" name="WLWRecentPostsMax" value="@Model.Settings.WLWRecentPostsMax" class="blog-admin__input blog-admin__input--narrow" aria-describedby="@(string.IsNullOrEmpty(hWlwMax) ? null : "hint-WLWRecentPostsMax")" />
                @if (!string.IsNullOrEmpty(hWlwMax)) { <p class="blog-admin__field-hint" id="hint-WLWRecentPostsMax">@hWlwMax</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="ModifyPageDetails">@L("lblModifyPageDetails", "Modify page details")</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="ModifyPageDetails" name="ModifyPageDetails" value="true" @(Model.Settings.ModifyPageDetails ? "checked=\"checked\"" : null) aria-describedby="@(string.IsNullOrEmpty(hPageDetails) ? null : "hint-ModifyPageDetails")" />
                @if (!string.IsNullOrEmpty(hPageDetails)) { <p class="blog-admin__field-hint" id="hint-ModifyPageDetails">@hPageDetails</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="IncrementViewCount">@L("lblIncrementViewCount", "View count delay (sec)")</label>
              <div class="blog-admin__control">
                <input type="text" id="IncrementViewCount" name="IncrementViewCount" value="@Model.Settings.IncrementViewCount" class="blog-admin__input blog-admin__input--narrow" aria-describedby="@(string.IsNullOrEmpty(hViewCount) ? null : "hint-IncrementViewCount")" />
                @if (!string.IsNullOrEmpty(hViewCount)) { <p class="blog-admin__field-hint" id="hint-IncrementViewCount">@hViewCount</p> }
              </div>
            </div>
          </div>
        </section>

        <section class="blog-admin__section">
          <h2 class="blog-admin__section-title">@L("RSS", "RSS")</h2>
          <div class="blog-admin__fields">
            @{
              var hRssDefault = H("lblRssDefaultNrItems");
              var hRssMax = H("lblRssMaxNrItems");
              var hRssTtl = H("lblRssTtl");
              var hRssEmail = H("lblEmail");
              var hRssCopyright = H("lblRssDefaultCopyright");
              var hRssContent = H("lblRssAllowContentInFeed");
              var hRssW = H("lblRssImageWidth");
              var hRssH = H("lblRssImageHeight");
              var hRssOverride = H("lblRssImageSizeAllowOverride");
            }
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssDefaultNrItems">@L("lblRssDefaultNrItems", "Default items")</label>
              <div class="blog-admin__control">
                <input type="text" id="RssDefaultNrItems" name="RssDefaultNrItems" value="@Model.Settings.RssDefaultNrItems" class="blog-admin__input blog-admin__input--narrow" aria-describedby="@(string.IsNullOrEmpty(hRssDefault) ? null : "hint-RssDefaultNrItems")" />
                @if (!string.IsNullOrEmpty(hRssDefault)) { <p class="blog-admin__field-hint" id="hint-RssDefaultNrItems">@hRssDefault</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssMaxNrItems">@L("lblRssMaxNrItems", "Max items")</label>
              <div class="blog-admin__control">
                <input type="text" id="RssMaxNrItems" name="RssMaxNrItems" value="@Model.Settings.RssMaxNrItems" class="blog-admin__input blog-admin__input--narrow" aria-describedby="@(string.IsNullOrEmpty(hRssMax) ? null : "hint-RssMaxNrItems")" />
                @if (!string.IsNullOrEmpty(hRssMax)) { <p class="blog-admin__field-hint" id="hint-RssMaxNrItems">@hRssMax</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssTtl">@L("lblRssTtl", "TTL")</label>
              <div class="blog-admin__control">
                <input type="text" id="RssTtl" name="RssTtl" value="@Model.Settings.RssTtl" class="blog-admin__input blog-admin__input--narrow" aria-describedby="@(string.IsNullOrEmpty(hRssTtl) ? null : "hint-RssTtl")" />
                @if (!string.IsNullOrEmpty(hRssTtl)) { <p class="blog-admin__field-hint" id="hint-RssTtl">@hRssTtl</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssEmail">@L("lblEmail", "Email")</label>
              <div class="blog-admin__control">
                <input type="text" id="RssEmail" name="RssEmail" value="@Model.Settings.RssEmail" class="blog-admin__input" aria-describedby="@(string.IsNullOrEmpty(hRssEmail) ? null : "hint-RssEmail")" />
                @if (!string.IsNullOrEmpty(hRssEmail)) { <p class="blog-admin__field-hint" id="hint-RssEmail">@hRssEmail</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssDefaultCopyright">@L("lblRssDefaultCopyright", "Default copyright")</label>
              <div class="blog-admin__control">
                <input type="text" id="RssDefaultCopyright" name="RssDefaultCopyright" value="@Model.Settings.RssDefaultCopyright" class="blog-admin__input blog-admin__input--wide" aria-describedby="@(string.IsNullOrEmpty(hRssCopyright) ? null : "hint-RssDefaultCopyright")" />
                @if (!string.IsNullOrEmpty(hRssCopyright)) { <p class="blog-admin__field-hint" id="hint-RssDefaultCopyright">@hRssCopyright</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssAllowContentInFeed">@L("lblRssAllowContentInFeed", "Allow content in feed")</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="RssAllowContentInFeed" name="RssAllowContentInFeed" value="true" @(Model.Settings.RssAllowContentInFeed ? "checked=\"checked\"" : null) aria-describedby="@(string.IsNullOrEmpty(hRssContent) ? null : "hint-RssAllowContentInFeed")" />
                @if (!string.IsNullOrEmpty(hRssContent)) { <p class="blog-admin__field-hint" id="hint-RssAllowContentInFeed">@hRssContent</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssImageWidth">@L("lblRssImageWidth", "Image width")</label>
              <div class="blog-admin__control">
                <input type="text" id="RssImageWidth" name="RssImageWidth" value="@Model.Settings.RssImageWidth" class="blog-admin__input blog-admin__input--narrow" aria-describedby="@(string.IsNullOrEmpty(hRssW) ? null : "hint-RssImageWidth")" />
                @if (!string.IsNullOrEmpty(hRssW)) { <p class="blog-admin__field-hint" id="hint-RssImageWidth">@hRssW</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssImageHeight">@L("lblRssImageHeight", "Image height")</label>
              <div class="blog-admin__control">
                <input type="text" id="RssImageHeight" name="RssImageHeight" value="@Model.Settings.RssImageHeight" class="blog-admin__input blog-admin__input--narrow" aria-describedby="@(string.IsNullOrEmpty(hRssH) ? null : "hint-RssImageHeight")" />
                @if (!string.IsNullOrEmpty(hRssH)) { <p class="blog-admin__field-hint" id="hint-RssImageHeight">@hRssH</p> }
              </div>
            </div>
            <div class="blog-admin__field">
              <label class="blog-admin__label" for="RssImageSizeAllowOverride">@L("lblRssImageSizeAllowOverride", "Image size override")</label>
              <div class="blog-admin__control">
                <input type="checkbox" id="RssImageSizeAllowOverride" name="RssImageSizeAllowOverride" value="true" @(Model.Settings.RssImageSizeAllowOverride ? "checked=\"checked\"" : null) aria-describedby="@(string.IsNullOrEmpty(hRssOverride) ? null : "hint-RssImageSizeAllowOverride")" />
                @if (!string.IsNullOrEmpty(hRssOverride)) { <p class="blog-admin__field-hint" id="hint-RssImageSizeAllowOverride">@hRssOverride</p> }
              </div>
            </div>
          </div>
        </section>

        <div class="blog-admin__actions">
          <button type="submit" class="blog-admin__btn blog-admin__btn--primary">@updateLabel</button>
          <a href="@DotNetNuke.Common.Globals.NavigateURL()" class="blog-admin__btn blog-admin__btn--secondary">@cancelLabel</a>
        </div>
      </form>
    </div>

    <div class="blog-admin__tabpanel" role="tabpanel" data-tabpanel="categories" hidden>
      @if (!Model.HasVocabulary)
      {
        <div class="blog-admin__callout blog-admin__callout--warning">
          <div class="blog-admin__callout-body">
            <p class="blog-admin__callout-title">No category vocabulary configured</p>
            <p class="blog-admin__callout-text">Categories need a vocabulary before they can be managed. Create one to continue, or select a vocabulary on the Settings tab.</p>
          </div>
          <button type="submit" form="blog-admin-create-vocab" class="blog-admin__btn blog-admin__btn--callout">Create vocabulary</button>
        </div>
      }
      else
      {
        <div class="Blog"
             data-moduleid="@Dnn.ActiveModule.ModuleID"
             data-component="categories-editor"
             data-vocabulary-id="@Model.Settings.VocabularyId"
             data-default-locale="@Model.DefaultLocale"
             data-locales="@localesJson"
             data-multilingual="@(Model.ShowMultilingualLinks ? "true" : "false")">
        </div>
      }
    </div>

    <div class="blog-admin__tabpanel" role="tabpanel" data-tabpanel="tags" hidden>
      <div class="Blog"
           data-moduleid="@Dnn.ActiveModule.ModuleID"
           data-component="tags-editor"
           data-default-locale="@Model.DefaultLocale"
           data-locales="@localesJson">
      </div>
    </div>
  </div>

  <div class="DotNetNukeBlog"
       data-moduleid="@Dnn.ActiveModule.ModuleID"
       data-tabid="@Dnn.ActiveModule.TabID"
       data-locale="@Locale"
       data-resources="@SerializedResources()"
       data-security="@securityJson">
  </div>

  @if (!Model.HasVocabulary)
  {
    <form id="blog-admin-create-vocab" action="@Url.Action("CreateVocabulary", "Admin")" method="post" hidden>
      @MvcHtml.AntiForgeryToken()
    </form>
  }
</div>
<script type="text/javascript">
  (function () {
    var root = document.querySelector('[data-blog-admin-tabs]');
    if (!root) return;
    var tabs = root.querySelectorAll('.blog-admin__tab');
    var panels = root.querySelectorAll('.blog-admin__tabpanel');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var id = tab.getAttribute('data-tab');
        tabs.forEach(function (t) {
          var on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach(function (p) {
          var on = p.getAttribute('data-tabpanel') === id;
          p.classList.toggle('is-active', on);
          if (on) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', 'hidden'); }
        });
      });
    });
  })();
</script>
