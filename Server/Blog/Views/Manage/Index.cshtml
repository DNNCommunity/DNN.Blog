@inherits BlogWebPage<DotNetNuke.Modules.Blog.Models.ManageViewModel>
@using DotNetNuke.Modules.Blog.Common
@using DotNetNuke.Modules.Blog.Models
@using System.Linq
@{
  var security = BlogModuleContext.Security;
  var securityJson = Newtonsoft.Json.JsonConvert.SerializeObject(new
  {
    UserId = Dnn.User.UserID,
    CanView = true,
    CanEdit = security.CanEditPost || security.IsEditor || security.IsBlogger,
    IsAdmin = security.UserIsAdmin
  });
  var blogsJson = Newtonsoft.Json.JsonConvert.SerializeObject(
    Model.Blogs.Select(b => new { BlogId = b.BlogID, Title = b.Title }));

  Func<string, string> ToLocalPath = url =>
  {
    if (string.IsNullOrWhiteSpace(url))
    {
      return url ?? "";
    }
    System.Uri absolute;
    if (System.Uri.TryCreate(url, System.UriKind.Absolute, out absolute))
    {
      return absolute.PathAndQuery;
    }
    return url;
  };

  // Use "section" — DNN reserves "tab" for page (TabId) routing.
  // Keep section in the query string so return URLs survive DNN friendly-URL rewriting.
  string manageBaseUrl = Url.Action("Index", "Manage") ?? "";
  string postsSectionUrl = manageBaseUrl + (manageBaseUrl.IndexOf('?') >= 0 ? "&" : "?") + "section=" + ManageViewModel.SectionPosts;
  string commentsSectionUrl = manageBaseUrl + (manageBaseUrl.IndexOf('?') >= 0 ? "&" : "?") + "section=" + ManageViewModel.SectionComments;
  string blogsSectionUrl = manageBaseUrl + (manageBaseUrl.IndexOf('?') >= 0 ? "&" : "?") + "section=" + ManageViewModel.SectionBlogs;
  string apiTokensSectionUrl = manageBaseUrl + (manageBaseUrl.IndexOf('?') >= 0 ? "&" : "?") + "section=" + ManageViewModel.SectionApiTokens;
  string postsReturnUrl = ToLocalPath(postsSectionUrl);

  int visibleSections =
    (Model.ShowPostsSection ? 1 : 0) +
    (Model.ShowCommentsSection ? 1 : 0) +
    (Model.ShowBlogsSection ? 1 : 0) +
    (Model.ShowApiTokensSection ? 1 : 0);
  bool showTabs = visibleSections > 1;
  bool postsActive = Model.ActiveSection == ManageViewModel.SectionPosts;
  bool commentsActive = Model.ActiveSection == ManageViewModel.SectionComments;
  bool blogsActive = Model.ActiveSection == ManageViewModel.SectionBlogs;
  bool apiTokensActive = Model.ActiveSection == ManageViewModel.SectionApiTokens;
}
<div class="blog-manage">
  <header class="blog-manage__header">
    <h1 class="blog-manage__title">Manage</h1>
    <p class="blog-manage__subtitle">Blogs and posts for this module</p>
  </header>

  @if (showTabs)
  {
    <nav class="blog-manage__tablist" role="tablist" aria-label="Manage sections">
      @if (Model.ShowPostsSection)
      {
        <a role="tab"
           class="blog-manage__tab@(postsActive ? " is-active" : "")"
           href="@postsSectionUrl"
           aria-selected="@(postsActive ? "true" : "false")"
           id="manage-tab-posts">@Dnn.LocalizeString("Posts")</a>
      }
      @if (Model.ShowCommentsSection)
      {
        <a role="tab"
           class="blog-manage__tab@(commentsActive ? " is-active" : "")"
           href="@commentsSectionUrl"
           aria-selected="@(commentsActive ? "true" : "false")"
           id="manage-tab-comments">@(Dnn.LocalizeString("Comments") ?? "Comments")</a>
      }
      @if (Model.ShowBlogsSection)
      {
        <a role="tab"
           class="blog-manage__tab@(blogsActive ? " is-active" : "")"
           href="@blogsSectionUrl"
           aria-selected="@(blogsActive ? "true" : "false")"
           id="manage-tab-blogs">@Dnn.LocalizeString("Blogs")</a>
      }
      @if (Model.ShowApiTokensSection)
      {
        <a role="tab"
           class="blog-manage__tab@(apiTokensActive ? " is-active" : "")"
           href="@apiTokensSectionUrl"
           aria-selected="@(apiTokensActive ? "true" : "false")"
           id="manage-tab-apitokens">@Dnn.LocalizeString("ApiTokens")</a>
      }
    </nav>
  }

  @if (Model.ShowPostsSection && postsActive)
  {
    <section class="blog-manage__section"
             role="tabpanel"
             aria-labelledby="@(showTabs ? "manage-tab-posts" : null)">
      @if (!showTabs)
      {
        <h2 class="blog-manage__section-title">@Dnn.LocalizeString("Posts")</h2>
      }
      <div class="DotNetNukeBlog"
           data-moduleid="@Dnn.ActiveModule.ModuleID"
           data-tabid="@Dnn.ActiveModule.TabID"
           data-locale="@Locale"
           data-resources="@SerializedResources()"
           data-security="@securityJson">
      </div>
      <div class="Blog"
           data-moduleid="@Dnn.ActiveModule.ModuleID"
           data-component="posts-manage-table"
           data-edit-url="@Url.Action("Edit", "Post", new { returnUrl = postsReturnUrl })"
           data-blogs="@blogsJson"
           data-delete-confirm="@(Dnn.LocalizeString("DeletePost") ?? "Delete this post?")"
           data-delete-label="@(Dnn.LocalizeString("Delete") ?? "Delete")"
           data-cancel-label="@(Dnn.LocalizeString("Cancel") ?? "Cancel")">
      </div>
    </section>
  }

  @if (Model.ShowCommentsSection && commentsActive)
  {
    <section class="blog-manage__section"
             role="tabpanel"
             aria-labelledby="@(showTabs ? "manage-tab-comments" : null)">
      @if (!showTabs)
      {
        <h2 class="blog-manage__section-title">@(Dnn.LocalizeString("Comments") ?? "Comments")</h2>
      }
      <div class="DotNetNukeBlog"
           data-moduleid="@Dnn.ActiveModule.ModuleID"
           data-tabid="@Dnn.ActiveModule.TabID"
           data-locale="@Locale"
           data-resources="@SerializedResources()"
           data-security="@securityJson">
      </div>
      <div class="Blog"
           data-moduleid="@Dnn.ActiveModule.ModuleID"
           data-component="comments-manage-table"
           data-blogs="@blogsJson"
           data-delete-confirm="@(Dnn.LocalizeString("DeleteCommentConfirm") ?? "Delete this comment? Its content will be replaced with a placeholder.")"
           data-bulk-delete-confirm="@(Dnn.LocalizeString("BulkDeleteCommentsConfirm") ?? "Delete the selected comments? Their content will be replaced with a placeholder.")"
           data-delete-label="@(Dnn.LocalizeString("Delete") ?? "Delete")"
           data-edit-label="@(Dnn.LocalizeString("Edit") ?? "Edit")"
           data-save-label="@(Dnn.LocalizeString("Save") ?? "Save")"
           data-comment-label="@(Dnn.LocalizeString("Comment") ?? "Comment")"
           data-flag-label="@(Dnn.LocalizeString("FlagComment") ?? "Flag")"
           data-flag-confirm="@(Dnn.LocalizeString("FlagCommentConfirm") ?? "Flag this comment? It will be hidden from public view.")"
           data-bulk-delete-label="@(Dnn.LocalizeString("DeleteSelected") ?? "Delete selected")"
           data-cancel-label="@(Dnn.LocalizeString("Cancel") ?? "Cancel")"
           data-search-placeholder="@(Dnn.LocalizeString("SearchComments") ?? "Search comments")"
           data-author-placeholder="@(Dnn.LocalizeString("FilterByAuthor") ?? "Filter by author")"
           data-all-blogs-label="@(Dnn.LocalizeString("AllBlogs") ?? "All blogs")"
           data-all-statuses-label="@(Dnn.LocalizeString("AllStatuses") ?? "All statuses")"
           data-show-more-label="@(Dnn.LocalizeString("ShowMore") ?? "Show more")"
           data-show-less-label="@(Dnn.LocalizeString("ShowLess") ?? "Show less")"
           data-empty-label="@(Dnn.LocalizeString("NoCommentsFound") ?? "No comments found.")"
           data-approved-label="@(Dnn.LocalizeString("Approved") ?? "Approved")"
           data-pending-label="@(Dnn.LocalizeString("Pending") ?? "Pending")"
           data-deleted-label="@(Dnn.LocalizeString("Deleted") ?? "Deleted")">
      </div>
    </section>
  }

  @if (Model.ShowBlogsSection && blogsActive)
  {
    <section class="blog-manage__section"
             role="tabpanel"
             aria-labelledby="@(showTabs ? "manage-tab-blogs" : null)">
      @if (!showTabs)
      {
        <h2 class="blog-manage__section-title">@Dnn.LocalizeString("Blogs")</h2>
      }
      <div class="blog-manage__table-wrap">
        <table class="blog-manage__table">
          <thead>
            <tr>
              <th colspan="3"></th>
              <th>@Dnn.LocalizeString("Blog")</th>
              <th>@Dnn.LocalizeString("Owner")</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var blog in Model.Blogs)
            {
              <tr>
                <td class="blog-manage__actions-cell">
                  <a class="blog-manage__icon-btn" href="@Url.Action("Edit", "Blog", new { Blog = blog.BlogID })" title="Edit">
                    <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                  </a>
                </td>
                <td class="blog-manage__actions-cell">
                  <a class="blog-manage__icon-btn" href="@Url.Action("Index", "Import", new { Blog = blog.BlogID })" title="Import">
                    <i class="fa fa-download" aria-hidden="true"></i>
                  </a>
                </td>
                <td class="blog-manage__actions-cell">
                  <a class="blog-manage__icon-btn" href="@Url.Action("Export", "Blog", new { Blog = blog.BlogID })" title="@Dnn.LocalizeString("Export")">
                    <i class="fa fa-upload" aria-hidden="true"></i>
                  </a>
                </td>
                <td>@blog.Title</td>
                <td>@blog.DisplayName</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
      @if (Model.CanAddBlog)
      {
        <div class="blog-manage__section-actions">
          <a href="@Url.Action("Edit", "Blog")" class="blog-manage__btn blog-manage__btn--secondary">@Dnn.LocalizeString("cmdAdd")</a>
        </div>
      }
    </section>
  }

  @if (Model.ShowApiTokensSection && apiTokensActive)
  {
    <section class="blog-manage__section"
             role="tabpanel"
             aria-labelledby="@(showTabs ? "manage-tab-apitokens" : null)">
      @if (!showTabs)
      {
        <h2 class="blog-manage__section-title">@Dnn.LocalizeString("ApiTokens")</h2>
      }
      <div class="DotNetNukeBlog"
           data-moduleid="@Dnn.ActiveModule.ModuleID"
           data-tabid="@Dnn.ActiveModule.TabID"
           data-locale="@Locale"
           data-resources="@SerializedResources()"
           data-security="@securityJson">
      </div>
      <div class="BlogApiTokens"
           data-moduleid="@Dnn.ActiveModule.ModuleID"
           data-component="api-tokens-manager"
           data-add-label="@(Dnn.LocalizeString("AddToken") ?? "Add Token")"
           data-name-label="@(Dnn.LocalizeString("TokenName") ?? "Token name")"
           data-create-title="@(Dnn.LocalizeString("CreateTokenTitle") ?? "Create API Token")"
           data-create-label="@(Dnn.LocalizeString("CreateToken") ?? "Create")"
           data-cancel-label="@(Dnn.LocalizeString("Cancel") ?? "Cancel")"
           data-token-created-title="@(Dnn.LocalizeString("TokenCreatedTitle") ?? "Your API Token")"
           data-token-created-warning="@(Dnn.LocalizeString("TokenCreatedWarning") ?? "Copy this token now. It cannot be shown again.")"
           data-close-label="@(Dnn.LocalizeString("Close") ?? "Close")"
           data-copy-label="@(Dnn.LocalizeString("CopyToken") ?? "Copy")"
           data-revoke-label="@(Dnn.LocalizeString("Revoke") ?? "Revoke")"
           data-revoke-confirm="@(Dnn.LocalizeString("RevokeTokenConfirm") ?? "Revoke this API token? It will stop working immediately.")"
           data-name-header="@(Dnn.LocalizeString("TokenNameHeader") ?? "Name")"
           data-created-header="@(Dnn.LocalizeString("CreatedHeader") ?? "Created")"
           data-expires-header="@(Dnn.LocalizeString("ExpiresHeader") ?? "Expires")"
           data-last-used-header="@(Dnn.LocalizeString("LastUsedHeader") ?? "Last Used")"
           data-status-header="@(Dnn.LocalizeString("StatusHeader") ?? "Status")"
           data-actions-header="@(Dnn.LocalizeString("ActionsHeader") ?? "Actions")"
           data-status-active="@(Dnn.LocalizeString("StatusActive") ?? "Active")"
           data-status-revoked="@(Dnn.LocalizeString("StatusRevoked") ?? "Revoked")"
           data-status-expired="@(Dnn.LocalizeString("StatusExpired") ?? "Expired")"
           data-empty-label="@(Dnn.LocalizeString("NoApiTokens") ?? "No API tokens yet.")">
      </div>
    </section>
  }

  <div class="blog-manage__footer">
    <a href="@DotNetNuke.Common.Globals.NavigateURL()" class="blog-manage__btn blog-manage__btn--primary">@Dnn.LocalizeString("cmdReturn")</a>
  </div>
</div>
