@inherits BlogWebPage<DotNetNuke.Modules.Blog.Models.BlogEditViewModel>
@using System
@using DotNetNuke.Modules.Blog.Common
@{
  Func<string, string, string> L = (key, fallback) =>
  {
    var s = Dnn.LocalizeString(key);
    if (string.IsNullOrWhiteSpace(s)) s = Dnn.LocalizeString(key + ".Text");
    return string.IsNullOrWhiteSpace(s) ? fallback : s;
  };
  Func<string, string> H = key =>
  {
    var helpKey = key.EndsWith(".Help", StringComparison.OrdinalIgnoreCase) ? key : key + ".Help";
    var s = Dnn.LocalizeString(helpKey);
    return string.IsNullOrWhiteSpace(s) ? "" : s;
  };
  var saveLabel = L("cmdSave", "Save");
  var cancelLabel = L("Cancel", "Cancel");
  var deleteLabel = L("Delete", "Delete");
  var pageTitle = Model.IsNew ? "New blog" : L("ControlTitle_blogedit", "Edit Blog");
  var contentFormatDisabled = Model.IsNew ? null : "disabled";
  var contentFormatHtml = Model.ContentFormat == 0 ? "selected" : null;
  var contentFormatMarkdown = Model.ContentFormat == 1 ? "selected" : null;
  var hintTitle = H("lblTitle");
  var hintDescription = H("lblDescription");
  var hintContentFormat = H("lblContentFormat");
  var hintPublished = H("lblPublic");
  var hintSyndicated = H("lblSyndicate");
  var hintCopyright = H("lblCopyright");
  var hintPingbacks = H("lblPingbacks");
  var hintTrackbacks = H("lblTrackbacks");
}
<div class="blog-admin">
  <header class="blog-admin__header">
    <h1 class="blog-admin__title">@pageTitle</h1>
    <p class="blog-admin__subtitle">@(Model.IsNew ? "Create a blog for this module" : "Blog options and syndication")</p>
  </header>

  <form action="@Url.Action("Edit", "Blog")" method="post">
    @MvcHtml.AntiForgeryToken()
    @Html.HiddenFor(m => m.BlogId)
    @Html.HiddenFor(m => m.IsNew)

    <section class="blog-admin__section">
      <h2 class="blog-admin__section-title">@L("General", "General")</h2>
      <div class="blog-admin__fields">
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="Title">@L("lblTitle", "Title")</label>
          <div class="blog-admin__control">
            @Html.TextBoxFor(m => m.Title, new { @class = "blog-admin__input", id = "Title", aria_describedby = string.IsNullOrEmpty(hintTitle) ? null : "hint-Title" })
            @if (!string.IsNullOrEmpty(hintTitle))
            {
              <p class="blog-admin__field-hint" id="hint-Title">@hintTitle</p>
            }
          </div>
        </div>
        <div class="blog-admin__field blog-admin__field--top">
          <label class="blog-admin__label" for="Description">@L("lblDescription", "Description")</label>
          <div class="blog-admin__control">
            @Html.TextAreaFor(m => m.Description, new { @class = "blog-admin__input blog-admin__textarea", id = "Description", rows = "4", aria_describedby = string.IsNullOrEmpty(hintDescription) ? null : "hint-Description" })
            @if (!string.IsNullOrEmpty(hintDescription))
            {
              <p class="blog-admin__field-hint" id="hint-Description">@hintDescription</p>
            }
          </div>
        </div>
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="ContentFormat">@L("lblContentFormat", "Content format")</label>
          <div class="blog-admin__control">
            <select id="ContentFormat" name="ContentFormat" class="blog-admin__input" @contentFormatDisabled aria-describedby="@(string.IsNullOrEmpty(hintContentFormat) ? null : "hint-ContentFormat")">
              <option value="0" @contentFormatHtml>HTML</option>
              <option value="1" @contentFormatMarkdown>Markdown</option>
            </select>
            @if (!string.IsNullOrEmpty(hintContentFormat))
            {
              <p class="blog-admin__field-hint" id="hint-ContentFormat">@hintContentFormat</p>
            }
          </div>
        </div>
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="Published">@L("lblPublic", "Published")</label>
          <div class="blog-admin__control">
            @Html.CheckBoxFor(m => m.Published, new { id = "Published", aria_describedby = string.IsNullOrEmpty(hintPublished) ? null : "hint-Published" })
            @if (!string.IsNullOrEmpty(hintPublished))
            {
              <p class="blog-admin__field-hint" id="hint-Published">@hintPublished</p>
            }
          </div>
        </div>
      </div>
    </section>

    <section class="blog-admin__section">
      <h2 class="blog-admin__section-title">Syndication</h2>
      <div class="blog-admin__fields">
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="Syndicated">@L("lblSyndicate", "Syndicated")</label>
          <div class="blog-admin__control">
            @Html.CheckBoxFor(m => m.Syndicated, new { id = "Syndicated", aria_describedby = string.IsNullOrEmpty(hintSyndicated) ? null : "hint-Syndicated" })
            @if (!string.IsNullOrEmpty(hintSyndicated))
            {
              <p class="blog-admin__field-hint" id="hint-Syndicated">@hintSyndicated</p>
            }
          </div>
        </div>
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="Copyright">@L("lblCopyright", "Copyright")</label>
          <div class="blog-admin__control">
            @Html.TextBoxFor(m => m.Copyright, new { @class = "blog-admin__input", id = "Copyright", aria_describedby = string.IsNullOrEmpty(hintCopyright) ? null : "hint-Copyright" })
            @if (!string.IsNullOrEmpty(hintCopyright))
            {
              <p class="blog-admin__field-hint" id="hint-Copyright">@hintCopyright</p>
            }
          </div>
        </div>
      </div>

      <h3 class="blog-admin__section-title" style="margin-top:1.25rem">@L("lblPingbacks", "Pingbacks")</h3>
      @if (!string.IsNullOrEmpty(hintPingbacks))
      {
        <p class="blog-admin__section-help">@hintPingbacks</p>
      }
      <div class="blog-admin__fields">
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="EnablePingBackSend">@L("Send", "Pingback send")</label>
          <div class="blog-admin__control">
            @Html.CheckBoxFor(m => m.EnablePingBackSend, new { id = "EnablePingBackSend" })
          </div>
        </div>
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="EnablePingBackReceive">@L("Receive", "Pingback receive")</label>
          <div class="blog-admin__control">
            @Html.CheckBoxFor(m => m.EnablePingBackReceive, new { id = "EnablePingBackReceive" })
          </div>
        </div>
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="AutoApprovePingBack">@L("AutoApprove", "Auto-approve pingback")</label>
          <div class="blog-admin__control">
            @Html.CheckBoxFor(m => m.AutoApprovePingBack, new { id = "AutoApprovePingBack" })
          </div>
        </div>
      </div>

      <h3 class="blog-admin__section-title" style="margin-top:1.25rem">@L("lblTrackbacks", "Trackbacks")</h3>
      @if (!string.IsNullOrEmpty(hintTrackbacks))
      {
        <p class="blog-admin__section-help">@hintTrackbacks</p>
      }
      <div class="blog-admin__fields">
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="EnableTrackBackSend">@L("Send", "Trackback send")</label>
          <div class="blog-admin__control">
            @Html.CheckBoxFor(m => m.EnableTrackBackSend, new { id = "EnableTrackBackSend" })
          </div>
        </div>
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="EnableTrackBackReceive">@L("Receive", "Trackback receive")</label>
          <div class="blog-admin__control">
            @Html.CheckBoxFor(m => m.EnableTrackBackReceive, new { id = "EnableTrackBackReceive" })
          </div>
        </div>
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="AutoApproveTrackBack">@L("AutoApprove", "Auto-approve trackback")</label>
          <div class="blog-admin__control">
            @Html.CheckBoxFor(m => m.AutoApproveTrackBack, new { id = "AutoApproveTrackBack" })
          </div>
        </div>
      </div>
    </section>

    <div class="blog-admin__actions">
      @if (!Model.IsNew)
      {
        <div class="blog-admin__actions-secondary">
          <button type="button" class="blog-admin__btn blog-admin__btn--danger" data-blog-delete-open="blog-delete-confirm">@deleteLabel</button>
        </div>
      }
      <button type="submit" class="blog-admin__btn blog-admin__btn--primary">@saveLabel</button>
      <a href="@Url.Action("Index", "Manage")" class="blog-admin__btn blog-admin__btn--secondary">@cancelLabel</a>
    </div>
  </form>

  @if (!Model.IsNew)
  {
    var deleteConfirm = L("DeleteBlog.Confirm", "Delete this blog? This cannot be undone.");
    <form id="blog-edit-delete" action="@Url.Action("Delete", "Blog")" method="post" hidden>
      @MvcHtml.AntiForgeryToken()
      <input type="hidden" name="Blog" value="@Model.BlogId" />
    </form>
    <div class="blog-dialog" id="blog-delete-confirm" hidden>
      <div class="blog-dialog__backdrop" data-blog-delete-close="blog-delete-confirm"></div>
      <div class="blog-dialog__panel blog-admin" role="dialog" aria-modal="true" aria-labelledby="blog-delete-confirm-title">
        <header class="blog-dialog__header">
          <h2 class="blog-dialog__title" id="blog-delete-confirm-title">@deleteLabel</h2>
          <button type="button" class="blog-dialog__close" data-blog-delete-close="blog-delete-confirm" aria-label="@cancelLabel">&times;</button>
        </header>
        <div class="blog-dialog__body">
          <p class="blog-dialog__message">@deleteConfirm</p>
        </div>
        <div class="blog-dialog__actions">
          <button type="button" class="blog-admin__btn blog-admin__btn--secondary" data-blog-delete-close="blog-delete-confirm">@cancelLabel</button>
          <button type="submit" form="blog-edit-delete" class="blog-admin__btn blog-admin__btn--danger">@deleteLabel</button>
        </div>
      </div>
    </div>
    <script type="text/javascript">
    (function () {
      var id = 'blog-delete-confirm';
      var root = document.getElementById(id);
      if (!root) return;
      function open() {
        root.removeAttribute('hidden');
        root.classList.add('is-open');
      }
      function close() {
        root.classList.remove('is-open');
        root.setAttribute('hidden', 'hidden');
      }
      document.querySelectorAll('[data-blog-delete-open="' + id + '"]').forEach(function (el) {
        el.addEventListener('click', function (e) {
          e.preventDefault();
          open();
        });
      });
      root.querySelectorAll('[data-blog-delete-close="' + id + '"]').forEach(function (el) {
        el.addEventListener('click', function (e) {
          e.preventDefault();
          close();
        });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && root.classList.contains('is-open')) close();
      });
    })();
    </script>
  }
</div>
