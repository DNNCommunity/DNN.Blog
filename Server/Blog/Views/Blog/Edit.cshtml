@inherits BlogWebPage<DotNetNuke.Modules.Blog.Models.BlogEditViewModel>
@using System
@using DotNetNuke.Modules.Blog.Common
@{
  Func<string, string, string> L = (key, fallback) =>
  {
    var s = Dnn.LocalizeString(key);
    if (string.IsNullOrWhiteSpace(s)) s = Dnn.LocalizeString(key + ".Text");
    return string.IsNullOrWhiteSpace(s) ? fallback : s;
  };
  Func<string, string> H = key =>
  {
    var helpKey = key.EndsWith(".Help", StringComparison.OrdinalIgnoreCase) ? key : key + ".Help";
    var s = Dnn.LocalizeString(helpKey);
    return string.IsNullOrWhiteSpace(s) ? "" : s;
  };
  var saveLabel = L("cmdSave", "Save");
  var cancelLabel = L("Cancel", "Cancel");
  var deleteLabel = L("Delete", "Delete");
  var addLabel = L("Add", "Add");
  var pageTitle = Model.IsNew ? "New blog" : L("ControlTitle_blogedit", "Edit Blog");
  var contentFormatDisabled = Model.IsNew ? null : "disabled";
  var contentFormatHtml = Model.ContentFormat == 0 ? "selected" : null;
  var contentFormatMarkdown = Model.ContentFormat == 1 ? "selected" : null;
  var hintTitle = H("lblTitle");
  var hintDescription = H("lblDescription");
  var hintContentFormat = H("lblContentFormat");
  var hintLocale = H("lblLocale");
  var hintFullLocalization = H("lblFullLocalization");
  var hintImage = H("lblImage");
  var hintPublished = H("lblPublic");
  var hintSyndicated = H("lblSyndicate");
  var hintSyndicationEmail = H("lblSyndicationEmail");
  var hintCopyright = H("lblCopyright");
  var hintIncludeImages = H("lblIncludeImagesInFeed");
  var hintIncludeAuthor = H("lblIncludeAuthorInFeed");
  var hintPingbacks = H("lblPingbacks");
  var hintTrackbacks = H("lblTrackbacks");
  var hintMustApprove = H("lblMustApproveGhostPosts");
  var hintPublishAsOwner = H("lblPublishAsOwner");
  var hintPermissions = H("lblPermissions");
  var sendLabel = L("Send", "Send");
  var receiveLabel = L("Receive", "Receive");
  var autoApproveLabel = L("AutoApprove", "Auto Approve");
  var removeImageLabel = L("cmdImageRemove", "Remove Image");
  var manageUrl = Url.Action("Index", "Manage") ?? "";
  var manageBlogsUrl = manageUrl + (manageUrl.IndexOf('?') >= 0 ? "&" : "?") + "section=blogs";
}
<div class="blog-admin">
  <header class="blog-admin__header">
    <h1 class="blog-admin__title">@pageTitle</h1>
    <p class="blog-admin__subtitle">@(Model.IsNew ? "Create a blog for this module" : "Blog options and syndication")</p>
  </header>

  <form action="@Url.Action("Edit", "Blog")" method="post" id="blog-edit-form" enctype="multipart/form-data">
    @MvcHtml.AntiForgeryToken()
    @Html.HiddenFor(m => m.BlogId)
    @Html.HiddenFor(m => m.IsNew)
    @Html.HiddenFor(m => m.ImageKey)
    <input type="hidden" name="permissionAction" id="permissionAction" value="" />

    <section class="blog-admin__section">
      <h2 class="blog-admin__section-title">@L("General", "General")</h2>
      <div class="blog-admin__fields">
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="Title">@L("lblTitle", "Title")</label>
          <div class="blog-admin__control">
            @Html.TextBoxFor(m => m.Title, new { @class = "blog-admin__input", id = "Title", aria_describedby = string.IsNullOrEmpty(hintTitle) ? null : "hint-Title" })
            @if (!string.IsNullOrEmpty(hintTitle))
            {
              <p class="blog-admin__field-hint" id="hint-Title">@hintTitle</p>
            }
          </div>
        </div>
        <div class="blog-admin__field blog-admin__field--top">
          <label class="blog-admin__label" for="Description">@L("lblDescription", "Description")</label>
          <div class="blog-admin__control">
            @Html.TextAreaFor(m => m.Description, new { @class = "blog-admin__input blog-admin__textarea", id = "Description", rows = "4", aria_describedby = string.IsNullOrEmpty(hintDescription) ? null : "hint-Description" })
            @if (!string.IsNullOrEmpty(hintDescription))
            {
              <p class="blog-admin__field-hint" id="hint-Description">@hintDescription</p>
            }
          </div>
        </div>
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="ContentFormat">@L("lblContentFormat", "Content format")</label>
          <div class="blog-admin__control">
            <select id="ContentFormat" name="ContentFormat" class="blog-admin__input" @contentFormatDisabled aria-describedby="@(string.IsNullOrEmpty(hintContentFormat) ? null : "hint-ContentFormat")">
              <option value="0" @contentFormatHtml>HTML</option>
              <option value="1" @contentFormatMarkdown>Markdown</option>
            </select>
            @if (!string.IsNullOrEmpty(hintContentFormat))
            {
              <p class="blog-admin__field-hint" id="hint-ContentFormat">@hintContentFormat</p>
            }
          </div>
        </div>
        @if (Model.ShowLocaleFields)
        {
          <div class="blog-admin__field">
            <label class="blog-admin__label" for="Locale">@L("lblLocale", "Language")</label>
            <div class="blog-admin__control">
              <select id="Locale" name="Locale" class="blog-admin__input" aria-describedby="@(string.IsNullOrEmpty(hintLocale) ? null : "hint-Locale")">
                @foreach (var loc in Model.LocaleOptions)
                {
                  <option value="@loc.Code" @(string.Equals(Model.Locale, loc.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@loc.Name</option>
                }
              </select>
              @if (!string.IsNullOrEmpty(hintLocale))
              {
                <p class="blog-admin__field-hint" id="hint-Locale">@hintLocale</p>
              }
            </div>
          </div>
          <div class="blog-admin__field blog-admin__field--check">
            <label class="blog-admin__label" for="FullLocalization">@L("lblFullLocalization", "Full Localization")</label>
            <div class="blog-admin__control">
              <div class="blog-admin__check-row">
                @Html.CheckBoxFor(m => m.FullLocalization, new { id = "FullLocalization", aria_describedby = string.IsNullOrEmpty(hintFullLocalization) ? null : "hint-FullLocalization" })
                @if (!string.IsNullOrEmpty(hintFullLocalization))
                {
                  <span class="blog-admin__field-hint blog-admin__field-hint--beside" id="hint-FullLocalization">@hintFullLocalization</span>
                }
              </div>
            </div>
          </div>
        }
        <div class="blog-admin__field blog-admin__field--top">
          <label class="blog-admin__label" for="ImageFile">@L("lblImage", "Image")</label>
          <div class="blog-admin__control">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
              <div class="blog-admin__image-preview">
                <img src="@Model.ImageUrl" alt="" width="100" height="100" />
              </div>
            }
            <input type="file" id="ImageFile" name="ImageFile" class="blog-admin__input" accept=".jpg,.jpeg,.png,.gif,.bmp" aria-describedby="@(string.IsNullOrEmpty(hintImage) ? null : "hint-Image")" />
            @if (!string.IsNullOrEmpty(Model.ImageKey))
            {
              <div class="blog-admin__check-row" style="margin-top:0.5rem">
                <input type="checkbox" id="RemoveImage" name="RemoveImage" value="true" />
                <label for="RemoveImage">@removeImageLabel</label>
              </div>
            }
            @if (!string.IsNullOrEmpty(hintImage))
            {
              <p class="blog-admin__field-hint" id="hint-Image">@hintImage</p>
            }
          </div>
        </div>
        <div class="blog-admin__field blog-admin__field--check">
          <label class="blog-admin__label" for="Published">@L("lblPublic", "Published")</label>
          <div class="blog-admin__control">
            <div class="blog-admin__check-row">
              @Html.CheckBoxFor(m => m.Published, new { id = "Published", aria_describedby = string.IsNullOrEmpty(hintPublished) ? null : "hint-Published" })
              @if (!string.IsNullOrEmpty(hintPublished))
              {
                <span class="blog-admin__field-hint blog-admin__field-hint--beside" id="hint-Published">@hintPublished</span>
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="blog-admin__section">
      <h2 class="blog-admin__section-title">Syndication</h2>
      <div class="blog-admin__fields">
        <div class="blog-admin__field blog-admin__field--check">
          <label class="blog-admin__label" for="Syndicated">@L("lblSyndicate", "Syndicated")</label>
          <div class="blog-admin__control">
            <div class="blog-admin__check-row">
              @Html.CheckBoxFor(m => m.Syndicated, new { id = "Syndicated", aria_describedby = string.IsNullOrEmpty(hintSyndicated) ? null : "hint-Syndicated" })
              @if (!string.IsNullOrEmpty(hintSyndicated))
              {
                <span class="blog-admin__field-hint blog-admin__field-hint--beside" id="hint-Syndicated">@hintSyndicated</span>
              }
            </div>
          </div>
        </div>
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="SyndicationEmail">@L("lblSyndicationEmail", "Syndication Email")</label>
          <div class="blog-admin__control">
            @Html.TextBoxFor(m => m.SyndicationEmail, new { @class = "blog-admin__input", id = "SyndicationEmail", type = "email", aria_describedby = string.IsNullOrEmpty(hintSyndicationEmail) ? null : "hint-SyndicationEmail" })
            @if (!string.IsNullOrEmpty(hintSyndicationEmail))
            {
              <p class="blog-admin__field-hint" id="hint-SyndicationEmail">@hintSyndicationEmail</p>
            }
          </div>
        </div>
        <div class="blog-admin__field">
          <label class="blog-admin__label" for="Copyright">@L("lblCopyright", "Copyright")</label>
          <div class="blog-admin__control">
            @Html.TextBoxFor(m => m.Copyright, new { @class = "blog-admin__input", id = "Copyright", aria_describedby = string.IsNullOrEmpty(hintCopyright) ? null : "hint-Copyright" })
            @if (!string.IsNullOrEmpty(hintCopyright))
            {
              <p class="blog-admin__field-hint" id="hint-Copyright">@hintCopyright</p>
            }
          </div>
        </div>
        <div class="blog-admin__field blog-admin__field--check">
          <label class="blog-admin__label" for="IncludeImagesInFeed">@L("lblIncludeImagesInFeed", "Include Images In Feed")</label>
          <div class="blog-admin__control">
            <div class="blog-admin__check-row">
              @Html.CheckBoxFor(m => m.IncludeImagesInFeed, new { id = "IncludeImagesInFeed", aria_describedby = string.IsNullOrEmpty(hintIncludeImages) ? null : "hint-IncludeImagesInFeed" })
              @if (!string.IsNullOrEmpty(hintIncludeImages))
              {
                <span class="blog-admin__field-hint blog-admin__field-hint--beside" id="hint-IncludeImagesInFeed">@hintIncludeImages</span>
              }
            </div>
          </div>
        </div>
        <div class="blog-admin__field blog-admin__field--check">
          <label class="blog-admin__label" for="IncludeAuthorInFeed">@L("lblIncludeAuthorInFeed", "Include Author in Rss Feed")</label>
          <div class="blog-admin__control">
            <div class="blog-admin__check-row">
              @Html.CheckBoxFor(m => m.IncludeAuthorInFeed, new { id = "IncludeAuthorInFeed", aria_describedby = string.IsNullOrEmpty(hintIncludeAuthor) ? null : "hint-IncludeAuthorInFeed" })
              @if (!string.IsNullOrEmpty(hintIncludeAuthor))
              {
                <span class="blog-admin__field-hint blog-admin__field-hint--beside" id="hint-IncludeAuthorInFeed">@hintIncludeAuthor</span>
              }
            </div>
          </div>
        </div>
        <div class="blog-admin__field">
          <span class="blog-admin__label blog-admin__label--plain">@L("lblPingbacks", "Pingbacks")</span>
          <div class="blog-admin__control">
            <div class="blog-admin__inline-checks" aria-describedby="@(string.IsNullOrEmpty(hintPingbacks) ? null : "hint-Pingbacks")">
              <label class="blog-admin__inline-check">
                @Html.CheckBoxFor(m => m.EnablePingBackSend, new { id = "EnablePingBackSend" })
                <span>@sendLabel</span>
              </label>
              <label class="blog-admin__inline-check">
                @Html.CheckBoxFor(m => m.EnablePingBackReceive, new { id = "EnablePingBackReceive" })
                <span>@receiveLabel</span>
              </label>
              <label class="blog-admin__inline-check">
                @Html.CheckBoxFor(m => m.AutoApprovePingBack, new { id = "AutoApprovePingBack" })
                <span>@autoApproveLabel</span>
              </label>
            </div>
            @if (!string.IsNullOrEmpty(hintPingbacks))
            {
              <p class="blog-admin__field-hint" id="hint-Pingbacks">@hintPingbacks</p>
            }
          </div>
        </div>
        <div class="blog-admin__field">
          <span class="blog-admin__label blog-admin__label--plain">@L("lblTrackbacks", "Trackbacks")</span>
          <div class="blog-admin__control">
            <div class="blog-admin__inline-checks" aria-describedby="@(string.IsNullOrEmpty(hintTrackbacks) ? null : "hint-Trackbacks")">
              <label class="blog-admin__inline-check">
                @Html.CheckBoxFor(m => m.EnableTrackBackSend, new { id = "EnableTrackBackSend" })
                <span>@sendLabel</span>
              </label>
              <label class="blog-admin__inline-check">
                @Html.CheckBoxFor(m => m.EnableTrackBackReceive, new { id = "EnableTrackBackReceive" })
                <span>@receiveLabel</span>
              </label>
              <label class="blog-admin__inline-check">
                @Html.CheckBoxFor(m => m.AutoApproveTrackBack, new { id = "AutoApproveTrackBack" })
                <span>@autoApproveLabel</span>
              </label>
            </div>
            @if (!string.IsNullOrEmpty(hintTrackbacks))
            {
              <p class="blog-admin__field-hint" id="hint-Trackbacks">@hintTrackbacks</p>
            }
          </div>
        </div>
      </div>
    </section>

    <section class="blog-admin__section">
      <h2 class="blog-admin__section-title">@L("lblGhostOptions", "Permissions")</h2>
      <div class="blog-admin__fields">
        <div class="blog-admin__field blog-admin__field--check">
          <label class="blog-admin__label" for="MustApproveGhostPosts">@L("lblMustApproveGhostPosts", "Must Approve Ghostwritten Posts")</label>
          <div class="blog-admin__control">
            <div class="blog-admin__check-row">
              @Html.CheckBoxFor(m => m.MustApproveGhostPosts, new { id = "MustApproveGhostPosts", aria_describedby = string.IsNullOrEmpty(hintMustApprove) ? null : "hint-MustApproveGhostPosts" })
              @if (!string.IsNullOrEmpty(hintMustApprove))
              {
                <span class="blog-admin__field-hint blog-admin__field-hint--beside" id="hint-MustApproveGhostPosts">@hintMustApprove</span>
              }
            </div>
          </div>
        </div>
        <div class="blog-admin__field blog-admin__field--check">
          <label class="blog-admin__label" for="PublishAsOwner">@L("lblPublishAsOwner", "Publish As Owner")</label>
          <div class="blog-admin__control">
            <div class="blog-admin__check-row">
              @Html.CheckBoxFor(m => m.PublishAsOwner, new { id = "PublishAsOwner", aria_describedby = string.IsNullOrEmpty(hintPublishAsOwner) ? null : "hint-PublishAsOwner" })
              @if (!string.IsNullOrEmpty(hintPublishAsOwner))
              {
                <span class="blog-admin__field-hint blog-admin__field-hint--beside" id="hint-PublishAsOwner">@hintPublishAsOwner</span>
              }
            </div>
          </div>
        </div>
        <div class="blog-admin__field blog-admin__field--top">
          <span class="blog-admin__label">@L("lblPermissions", "Permissions")</span>
          <div class="blog-admin__control">
            @if (!string.IsNullOrEmpty(hintPermissions))
            {
              <p class="blog-admin__field-hint" id="hint-Permissions" style="margin-top:0;margin-bottom:0.75rem">@hintPermissions</p>
            }

            @if (Model.PermissionColumns != null)
            {
              for (var c = 0; c < Model.PermissionColumns.Count; c++)
              {
                @Html.HiddenFor(m => m.PermissionColumns[c].PermissionId)
                @Html.HiddenFor(m => m.PermissionColumns[c].PermissionKey)
                @Html.HiddenFor(m => m.PermissionColumns[c].Header)
              }
            }

            <div class="blog-admin__perm-grid-wrap">
              <table class="blog-admin__perm-grid">
                <colgroup>
                  <col class="blog-admin__perm-col-name" />
                  @if (Model.PermissionColumns != null)
                  {
                    foreach (var col in Model.PermissionColumns)
                    {
                      <col class="blog-admin__perm-col-check" />
                    }
                  }
                </colgroup>
                <thead>
                  <tr>
                    <th scope="col" class="blog-admin__perm-name">Role / User</th>
                    @if (Model.PermissionColumns != null)
                    {
                      foreach (var col in Model.PermissionColumns)
                      {
                        <th scope="col" class="blog-admin__perm-check">@col.Header</th>
                      }
                    }
                  </tr>
                </thead>
                <tbody>
                  @if (Model.RolePermissions != null)
                  {
                    var prevWasSystem = (bool?)null;
                    var roleStripe = 0;
                    for (var r = 0; r < Model.RolePermissions.Count; r++)
                    {
                      var roleRow = Model.RolePermissions[r];
                      var isSystem = roleRow.IsSystemRole;
                      var isSegmentStart = prevWasSystem == true && !isSystem;
                      if (isSegmentStart)
                      {
                        roleStripe = 0;
                      }
                      var roleClasses = "blog-admin__perm-role-row"
                        + (isSystem ? " blog-admin__perm-role-row--system" : " blog-admin__perm-role-row--custom")
                        + (isSegmentStart ? " blog-admin__perm-segment-start" : "")
                        + (roleStripe % 2 == 1 ? " blog-admin__perm-row--alt" : "");
                      <tr class="@roleClasses">
                        <th scope="row" class="blog-admin__perm-name">
                          @roleRow.RoleName
                          @Html.HiddenFor(m => m.RolePermissions[r].RoleId)
                          @Html.HiddenFor(m => m.RolePermissions[r].RoleName)
                          @Html.HiddenFor(m => m.RolePermissions[r].IsSystemRole)
                        </th>
                        @if (roleRow.Cells != null)
                        {
                          for (var c = 0; c < roleRow.Cells.Count; c++)
                          {
                            var cell = roleRow.Cells[c];
                            <td class="blog-admin__perm-check">
                              @Html.HiddenFor(m => m.RolePermissions[r].Cells[c].PermissionId)
                              @Html.HiddenFor(m => m.RolePermissions[r].Cells[c].PermissionKey)
                              @Html.HiddenFor(m => m.RolePermissions[r].Cells[c].Enabled)
                              @if (cell.Enabled)
                              {
                                @Html.CheckBoxFor(m => m.RolePermissions[r].Cells[c].AllowAccess)
                              }
                              else
                              {
                                <input type="hidden" name="RolePermissions[@r].Cells[@c].AllowAccess" value="false" />
                                <input type="checkbox" disabled="disabled" />
                              }
                            </td>
                          }
                        }
                      </tr>
                      prevWasSystem = isSystem;
                      roleStripe++;
                    }
                  }
                  @if (Model.UserPermissions != null)
                  {
                    for (var u = 0; u < Model.UserPermissions.Count; u++)
                    {
                      var userClasses = "blog-admin__perm-user-row"
                        + (u == 0 ? " blog-admin__perm-segment-start" : "")
                        + (u % 2 == 1 ? " blog-admin__perm-row--alt" : "");
                      <tr class="@userClasses">
                        <th scope="row" class="blog-admin__perm-name">
                          @(string.IsNullOrEmpty(Model.UserPermissions[u].DisplayName) ? Model.UserPermissions[u].Username : Model.UserPermissions[u].DisplayName)
                          @Html.HiddenFor(m => m.UserPermissions[u].UserId)
                          @Html.HiddenFor(m => m.UserPermissions[u].DisplayName)
                          @Html.HiddenFor(m => m.UserPermissions[u].Username)
                        </th>
                        @if (Model.UserPermissions[u].Cells != null)
                        {
                          for (var c = 0; c < Model.UserPermissions[u].Cells.Count; c++)
                          {
                            <td class="blog-admin__perm-check">
                              @Html.HiddenFor(m => m.UserPermissions[u].Cells[c].PermissionId)
                              @Html.HiddenFor(m => m.UserPermissions[u].Cells[c].PermissionKey)
                              @Html.HiddenFor(m => m.UserPermissions[u].Cells[c].Enabled)
                              @Html.CheckBoxFor(m => m.UserPermissions[u].Cells[c].AllowAccess)
                            </td>
                          }
                        }
                      </tr>
                    }
                  }
                  <tr class="blog-admin__perm-add-row">
                    <td class="blog-admin__perm-add-cell">
                      <div class="blog-admin__perm-add-user">
                        <label class="blog-admin__sr-only" for="AddPermissionUsername">User</label>
                        @Html.TextBoxFor(m => m.AddPermissionUsername, new { @class = "blog-admin__input blog-admin__perm-add-input", id = "AddPermissionUsername", autocomplete = "off", placeholder = "username" })
                      </div>
                    </td>
                    <td class="blog-admin__perm-add-cell" colspan="@(Model.PermissionColumns != null ? Model.PermissionColumns.Count : 0)">
                      <div class="blog-admin__perm-add-user">
                        <button type="submit" class="blog-admin__btn blog-admin__btn--secondary" id="blog-perm-add-user">Add User</button>
                      </div>
                      @if (!string.IsNullOrEmpty(Model.PermissionAddError))
                      {
                        <p class="blog-admin__field-hint blog-admin__perm-add-error">@Model.PermissionAddError</p>
                      }
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="blog-admin__actions">
      @if (!Model.IsNew)
      {
        <div class="blog-admin__actions-secondary">
          <button type="button" class="blog-admin__btn blog-admin__btn--danger" data-blog-delete-open="blog-delete-confirm">@deleteLabel</button>
        </div>
      }
      <button type="submit" class="blog-admin__btn blog-admin__btn--primary">@saveLabel</button>
      <a href="@manageBlogsUrl" class="blog-admin__btn blog-admin__btn--secondary">@cancelLabel</a>
    </div>
  </form>

  @if (!Model.IsNew)
  {
    var deleteConfirm = L("DeleteBlog.Confirm", "Delete this blog? This cannot be undone.");
    <form id="blog-edit-delete" action="@Url.Action("Delete", "Blog")" method="post" hidden>
      @MvcHtml.AntiForgeryToken()
      <input type="hidden" name="Blog" value="@Model.BlogId" />
    </form>
    <div class="blog-dialog" id="blog-delete-confirm" hidden>
      <div class="blog-dialog__backdrop" data-blog-delete-close="blog-delete-confirm"></div>
      <div class="blog-dialog__panel blog-admin" role="dialog" aria-modal="true" aria-labelledby="blog-delete-confirm-title">
        <header class="blog-dialog__header">
          <h2 class="blog-dialog__title" id="blog-delete-confirm-title">@deleteLabel</h2>
          <button type="button" class="blog-dialog__close" data-blog-delete-close="blog-delete-confirm" aria-label="@cancelLabel">&times;</button>
        </header>
        <div class="blog-dialog__body">
          <p class="blog-dialog__message">@deleteConfirm</p>
        </div>
        <div class="blog-dialog__actions">
          <button type="button" class="blog-admin__btn blog-admin__btn--secondary" data-blog-delete-close="blog-delete-confirm">@cancelLabel</button>
          <button type="submit" form="blog-edit-delete" class="blog-admin__btn blog-admin__btn--danger">@deleteLabel</button>
        </div>
      </div>
    </div>
  }
  <script type="text/javascript">
  (function () {
    // Nested forms are dropped by the browser; ensure the DNN Form accepts file uploads.
    var dnnForm = document.getElementById('Form');
    if (dnnForm) {
      dnnForm.setAttribute('enctype', 'multipart/form-data');
    }

    var addBtn = document.getElementById('blog-perm-add-user');
    var actionField = document.getElementById('permissionAction');
    if (addBtn && actionField) {
      addBtn.addEventListener('click', function () {
        actionField.value = 'addUser';
      });
    }
    var form = document.getElementById('blog-edit-form');
    if (form && actionField) {
      form.addEventListener('submit', function (e) {
        if (e.submitter && e.submitter.id === 'blog-perm-add-user') {
          actionField.value = 'addUser';
        } else if (actionField.value !== 'addUser') {
          actionField.value = '';
        }
      });
    }

    var id = 'blog-delete-confirm';
    var root = document.getElementById(id);
    if (!root) return;
    function open() {
      root.removeAttribute('hidden');
      root.classList.add('is-open');
    }
    function close() {
      root.classList.remove('is-open');
      root.setAttribute('hidden', 'hidden');
    }
    document.querySelectorAll('[data-blog-delete-open="' + id + '"]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        open();
      });
    });
    root.querySelectorAll('[data-blog-delete-close="' + id + '"]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        close();
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && root.classList.contains('is-open')) close();
    });
  })();
  </script>
</div>
