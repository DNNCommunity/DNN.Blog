@inherits BlogWebPage<DotNetNuke.Modules.Blog.Models.HomeViewModel>
@using DotNetNuke.Modules.Blog.Common
@{
  BlogModuleContext.EnsureInitialized();
  BlogModuleContext.AddModuleCss();
}

@if (Model.ShowManagementPanel)
{
  @Html.Partial("~/DesktopModules/MVC/Blog/Views/Shared/_ManagementPanel.cshtml")
}

<div class="dnnBlog">
  @Html.Raw(Model.TemplateHtml)
</div>

@if (!string.IsNullOrEmpty(Model.TrackBackBlurb))
{
  @Html.Raw(Model.TrackBackBlurb)
}

@if (Model.ShowComments)
{
  @Html.Partial("~/DesktopModules/MVC/Blog/Views/Shared/_Comments.cshtml")
}
