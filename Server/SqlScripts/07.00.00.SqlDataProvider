IF NOT EXISTS (SELECT * FROM SYS.COLUMNS WHERE NAME = N'ContentFormat' AND OBJECT_ID = OBJECT_ID(N'{databaseOwner}{objectQualifier}Blog_Blogs'))
BEGIN
 ALTER TABLE {databaseOwner}{objectQualifier}Blog_Blogs
 ADD ContentFormat TINYINT NULL
END
GO

IF EXISTS (SELECT * FROM SYS.COLUMNS WHERE NAME = N'ContentFormat' AND OBJECT_ID = OBJECT_ID(N'{databaseOwner}{objectQualifier}Blog_Blogs') AND is_nullable = 1)
BEGIN
 UPDATE {databaseOwner}{objectQualifier}Blog_Blogs
 SET ContentFormat=0
 WHERE ContentFormat IS NULL
END
GO

IF EXISTS (SELECT * FROM SYS.COLUMNS WHERE NAME = N'ContentFormat' AND OBJECT_ID = OBJECT_ID(N'{databaseOwner}{objectQualifier}Blog_Blogs') AND is_nullable = 1)
BEGIN
