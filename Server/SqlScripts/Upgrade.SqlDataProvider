CREATE VIEW {databaseOwner}{objectQualifier}vw_Blog_Posts
AS
SELECT
 p.*,
 ci.Content,
 ci.ContentKey,
 ci.ContentTypeID,
 ci.CreatedByUserID,
 ci.CreatedOnDate,
 ci.Indexed,
 ci.LastModifiedByUserID,
 ci.LastModifiedOnDate,
 ci.ModuleID,
 ci.StateID,
 ci.TabID,
 u.Username,
 u.Email,
 u.DisplayName,
 (SELECT COUNT(*) FROM {databaseOwner}{objectQualifier}Blog_Comments c WHERE c.ContentItemId=p.ContentItemId AND c.Approved=1) NrComments,
 b.ContentFormat
FROM {databaseOwner}{objectQualifier}Blog_Posts p
 INNER JOIN {databaseOwner}{objectQualifier}Blog_Blogs b ON b.BlogID=p.BlogID
 LEFT OUTER JOIN {databaseOwner}{objectQualifier}ContentItems ci ON p.ContentItemId = ci.ContentItemID
 INNER JOIN {databaseOwner}{objectQualifier}Users AS u ON ci.CreatedByUserID = u.UserID
